# Neon Auth — copy from Console → Auth → Configuration
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth

# At least 32 characters. Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Future content API (unused until that project exists)
API_URL=http://localhost:4000

# Gem Hunt / bft-games origin (no trailing slash)
NEXT_PUBLIC_GAMES_URL=http://localhost:3001
